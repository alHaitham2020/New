    <ControlTemplate x:Key="GalleryItemGlyphBorderTemplate" TargetType="{x:Type dxb:ItemBorderControl}">
        <Border CornerRadius="5" BorderBrush="#5192969C" BorderThickness="1">
            <ContentPresenter Margin="5"/>
        </Border>
    </ControlTemplate>

    
    <Style x:Key="{localt:RichDesignerViewThemeKey ResourceId=GalleryStyle}" TargetType="dxb:Gallery">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="AllowFilter" Value="False"/>
        <Setter Property="AllowToolTips" Value="True"/>
        <Setter Property="GroupCaptionVerticalAlignment" Value="Center"/>
        <Setter Property="GroupCaptionHorizontalAlignment" Value="Left"/>
        <Setter Property="ItemMargin" Value="5,2"/>
        <Setter Property="ItemCaptionHorizontalAlignment" Value="Center"/>
        <Setter Property="ItemCaptionVerticalAlignment" Value="Stretch"/>
        <Setter Property="ItemGlyphHorizontalAlignment" Value="Center"/>
        <Setter Property="ItemGlyphVerticalAlignment" Value="Top"/>
        <Setter Property="IsItemDescriptionVisible" Value="False"/>
        <Setter Property="IsItemGlyphVisible" Value="True"/>
        <Setter Property="GroupCaptionMargin" Value="30,20,0,10"/>
        <Setter Property="GroupItemsMargin" Value="10,0,0,20"/>
        <Setter Property="ItemCaptionMargin" Value="5"/>
        <Setter Property="ItemGlyphBorderPadding" Value="5"/>
        <Setter Property="AllowSmoothScrolling" Value="True"/>
        <Setter Property="ItemGlyphLocation" Value="Top"/>
        <Setter Property="ItemGlyphStretch" Value="Uniform"/>
        <Setter Property="ItemGlyphSize" Value="150,150"/>
        <Setter Property="HoverGlyphSize" Value="200,200"/>
        <Setter Property="AllowHoverImages" Value="False"/>
        <Setter Property="AllowHoverAnimation" Value="True"/>
        <Setter Property="VerticalScrollbarVisibility" Value="Visible"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemGlyphBorderTemplate" Value="{StaticResource GalleryItemGlyphBorderTemplate}"/>
        <Setter Property="GroupCaptionTemplate" Value="{StaticResource {localt:RichDesignerViewThemeKey ResourceId=GroupCaptionTemplate}}"/>
        <Setter Property="ItemCaptionTemplate" Value="{StaticResource {localt:RichDesignerViewThemeKey ResourceId=ItemCaptionTemplate}}"/>
    </Style>

</ResourceDictionary>