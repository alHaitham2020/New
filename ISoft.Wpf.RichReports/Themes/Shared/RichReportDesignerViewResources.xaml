    <DataTemplate x:Key="{localt:RichDesignerViewThemeKey ResourceId=GroupCaptionTemplate}">
        <Isoftui:ThemedBorderContentControl CornerRadius="5" Padding="2" AppearanceType="Primary">
            <TextBlock FontSize="12" 
                       FontFamily="{DynamicResource TajawalFontFamily}" 
                       Text="{Binding}" 
                       VerticalAlignment="Top" 
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"
                       FontWeight="SemiBold"
                       MaxWidth="150"/>
        </Isoftui:ThemedBorderContentControl>
    </DataTemplate>

    <DataTemplate x:Key="{localt:RichDesignerViewThemeKey ResourceId=ItemCaptionTemplate}">
        <Isoftui:ThemedBorderContentControl CornerRadius="5" Padding="2" AppearanceType="Alert">
            <TextBlock FontSize="12" 
                       FontFamily="{DynamicResource TajawalFontFamily}" 
                       Text="{Binding}" 
                       VerticalAlignment="Top" 
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"
                       FontWeight="SemiBold"
                       MaxWidth="150"/>
        </Isoftui:ThemedBorderContentControl>
    </DataTemplate>
    
    <DataTemplate x:Key="{localt:RichDesignerViewThemeKey ResourceId=StoreItemTemplate}">
        <ContentControl>
            <dxb:GalleryItem  Caption="{Binding Name}" 
                              Glyph="{Binding PreviewImage}" 
                              Command="{Binding RelativeSource={RelativeSource Self}, Path=(localc:RichReportDesignerControl.Designer).ActualCommands.OpenCommand}"
                              CommandParameter="{Binding .}">
            </dxb:GalleryItem>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="{localt:RichDesignerViewThemeKey ResourceId=DefaultItemTemplate}">
        <ContentControl>
            <dxb:GalleryItem Caption="{Binding Name}"
                             Glyph="{Binding PreviewImage}"
                             Command="{Binding RelativeSource={RelativeSource Self}, Path=(localc:RichReportDesignerControl.Designer).ActualCommands.OpenDefaultCommand}"
                             CommandParameter="{Binding .}">
            </dxb:GalleryItem>
        </ContentControl>
    </DataTemplate>

    <DataTemplate x:Key="{localt:RichDesignerViewThemeKey ResourceId=ReportItemTemplate}">
        <Isoftui:BusyIndicatorContentControl IsBusy="{Binding IsLoading}" 
                                             ShowBusyText="False"
                                             IndicatorVerticalAlignment="Center"
                                             VerticalContentAlignment="Stretch" 
                                             VerticalAlignment="Stretch" 
                                             Margin="2">

            <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="2" Padding="5">

                <Grid Width="120" MaxHeight="200" ClipToBounds="False" UseLayoutRounding="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <dx:DXImage
                         Source="{Binding Path=PreviewImage}"
                         UseLayoutRounding="True"
                         RenderOptions.EdgeMode="Aliased"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         SnapsToDevicePixels="True"/>

                    <TextBlock Margin="5" Grid.Row="1" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                </Grid>
            </Border>

        </Isoftui:BusyIndicatorContentControl>
    </DataTemplate>

