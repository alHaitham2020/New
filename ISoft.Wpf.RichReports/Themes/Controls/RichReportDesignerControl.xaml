<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ISoft.Wpf.RichReports.Controls"
                    xmlns:dxre="http://schemas.devexpress.com/winfx/2008/xaml/richedit"
                    xmlns:dxret="http://schemas.devexpress.com/winfx/2008/xaml/richedit/themekeys"
                    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" 
                    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" 
                    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
                    xmlns:Isoftui="http://schemas.ISoft.com/winfx/2008/xaml/core/ui" 
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:localt="clr-namespace:ISoft.Wpf.RichReports.Markup.ThemeResources">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ISoft.Wpf.RichReports;component/Themes/Internal/DesignerResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style TargetType="{x:Type local:RichReportDesignerControl}">
        <Setter Property="AllowDrop" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RichReportDesignerControl}">

                    <Grid x:Name="PART_Root"
                          Background="{TemplateBinding Background}"
                          SnapsToDevicePixels="True">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Ribbon -->
                        <Control x:Name="PART_RibbonHost"
                                 Grid.Row="0"
                                 IsTabStop="False"
                                 Focusable="False"
                                 KeyboardNavigation.IsTabStop="False"
                                 KeyboardNavigation.ControlTabNavigation="None"
                                 KeyboardNavigation.DirectionalNavigation="None"
                                 dxre:RichEditControl.RichEdit="{x:Reference PART_RichEdit}"
                                 Template="{StaticResource DesignerRibbonTemplate}"/>

                        <dxdo:DockLayoutManager x:Name="PART_DockContainer" Grid.Row="1" DockPanel.Dock="Left" Background="Transparent" ShowInvisibleItems="False">
                            
                            <dxdo:LayoutGroup Orientation="Horizontal">

                                <dxdo:LayoutPanel x:Name="PART_FieldsLayoutPane"
                                                  AllowContextMenu="False"
                                                  AllowDock="True" 
                                                  AllowHide="True"
                                                  AllowMove="False"
                                                  AllowClose="False"
                                                  AllowMaximize="False"
                                                  AllowMinimize="False"
                                                  AllowDockToDocumentGroup="False"
                                                  AllowFloat="False"
                                                  ShowInDocumentSelector="False" 
                                                  ItemWidth="220"
                                                  Caption="قائمة الحقول"
                                                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},Path=ShowFieldsPanel,Converter={dxmvvm:BooleanToVisibilityConverter}}">        
                                    <local:RichReportDesignerFieldsPanel x:Name="PART_FieldsPanel" 
                                                                         FieldsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=DisplayFields}"/>
                                </dxdo:LayoutPanel>

                                <dxdo:DocumentPanel x:Name="PART_DesignerDocumentPane" Caption="التصميم" Background="Transparent">

                                    <local:XpfRichEditorControl 
                                                      x:Name="PART_RichEdit"
                                                      CommandBarStyle="Empty"
                                                      UseLayoutRounding="True" 
                                                      AllowDrop="True"
                                                      FlowDirection="LeftToRight"
                                                      ActiveViewType="PrintLayout"
                                                      VerticalAlignment="Stretch"
                                                      HorizontalAlignment="Stretch">
                                        
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:DependencyPropertyBehavior EventName="ZoomChanged" PropertyName="ActiveView.ZoomFactor" Binding="{Binding Path=EditValue,Mode=TwoWay,ElementName=zoomEdit}"/>
                                        </dxmvvm:Interaction.Behaviors>
                                        
                                        <dxre:RichEditControl.RibbonActions>
                                            <!--<dxb:UpdateAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonPage_File}" PropertyName="IsVisible" Value="False" />-->
                                            <dxb:RemoveAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonPage_References}" />
                                            <dxb:RemoveAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonPage_Review}" />
                                            <dxb:RemoveAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonPage_MailMerge}" />
                                            <dxb:RemoveAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonGroup_View_DocumentViews}" />
                                            <dxb:RemoveAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonItem_PageLayout_LineNumbersCommandGroup}" />
                                            <dxb:RemoveAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonItem_PageLayout_ChangeHyphenationCommandGroup}" />
                                            <dxb:RemoveAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonGroup_File_Info}" />
                                            <dxb:RemoveAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonItem_File_Common_SaveAs}" />
                                            <dxb:RemoveAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonItem_File_Common_New}" />
                                            <dxb:RemoveAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonItem_File_Common_Open}" />
                                            <dxb:RemoveAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonItem_File_Common_Print}" />
                                            <dxb:RemoveAction ElementName="{x:Static dxre:DefaultBarItemNames.RibbonItem_File_Common_QuickPrint}" />

                                            <!--<dxb:InsertAction Index="0" ContainerName="{x:Static dxre:DefaultBarItemNames.RibbonPage_Home}">
                                                            <dxr:RibbonPageGroup Caption="معاينة">
                                                                <dxb:BarButtonItem Style="{DynamicResource {dxret:BarItemStyleKey ResourceKey=RibbonItem_File_Common_PrintPreview}}" />   
                                                            </dxr:RibbonPageGroup>
                                                        </dxb:InsertAction>

                                                        <dxb:InsertAction Index="1" ContainerName="{x:Static dxre:DefaultBarItemNames.RibbonPage_Home}">
                                                            <dxr:RibbonPageGroup Caption="الحقول">
                                                                <dxb:BarButtonItem Command="{DXCommand '@p.HighlightFields()'}" Style="{DynamicResource {dxret:BarItemStyleKey ResourceKey=RibbonItem_File_Info_DocumentProperties}}" />
                                                            </dxr:RibbonPageGroup>
                                                        </dxb:InsertAction>-->

                                        </dxre:RichEditControl.RibbonActions>

                                        <dxre:RichEditControl.DocumentCapabilitiesOptions>
                                            <dxre:DXRichEditDocumentCapabilitiesOptions Charts="Disabled" FootNotes="Disabled" 
                                                                                        EndNotes="Disabled" Comments="Disabled" 
                                                                                        Bookmarks="Disabled" TrackChanges="Disabled"/>
                                        </dxre:RichEditControl.DocumentCapabilitiesOptions>

                                        <dxre:RichEditControl.CommentOptions>
                                            <dxre:DXRichEditCommentOptions Visibility="Hidden" />
                                        </dxre:RichEditControl.CommentOptions>

                                        <dxre:RichEditControl.MenuCustomizations>
                                            <dxre:RichEditMenuCustomization MenuType="Field">
                                                <dxb:BarButtonItem Name="bRemoveSelectedField" 
                                                                   Content="حذف الحقل" 
                                                                   Command="{Binding RelativeSource={RelativeSource Self}, Path=(local:RichReportDesignerControl.Designer).EditControl.XpfCommandProvider.RemoveSelectedField}"
                                                                   Style="{Isoftui:BarsThemeResource ResourceId=DeleteBarButtonStyle}" />
                                                <dxb:BarButtonItem Name="bRemoveSelectedFields" 
                                                                   Content="حذف الحقول" 
                                                                   Command="{Binding RelativeSource={RelativeSource Self}, Path=(local:RichReportDesignerControl.Designer).EditControl.XpfCommandProvider.RemoveSelectedFields}"
                                                                   Style="{Isoftui:BarsThemeResource ResourceId=DeleteSelectedBarButtonStyle}" />  
                                            </dxre:RichEditMenuCustomization>
                                            
                                            <!--<dxre:RichEditMenuCustomization MenuType="InlinePicture">
                                                <dxre:RemoveRichEditCommandAction Id="{x:Static MemberType=dxrecore:RichEditCommandId, Member=CutSelection}" />
                                            </dxre:RichEditMenuCustomization>
                                            <dxre:RichEditMenuCustomization MenuType="TableCell">
                                                <dxre:RemoveRichEditCommandAction Id="{x:Static MemberType=dxrecore:RichEditCommandId, Member=ShowDeleteTableCellsFormMenuItem}" />
                                                <dxre:RemoveRichEditCommandAction Id="{x:Static MemberType=dxrecore:RichEditCommandId, Member=ShowTablePropertiesFormMenuItem}" />
                                                <dxb:BarButtonItemLink BarItemName="customSetAllBordersMenuItem" />
                                            </dxre:RichEditMenuCustomization>-->
                                        </dxre:RichEditControl.MenuCustomizations>
                                        
                                    </local:XpfRichEditorControl>
                                    
                                </dxdo:DocumentPanel>
                                
                            </dxdo:LayoutGroup>
                            
                        </dxdo:DockLayoutManager>

                        <!-- Status Bar -->
                        <dxr:RibbonStatusBarControl x:Name="PART_RibbonStatusBarControl" Grid.Row="2" DockPanel.Dock="Bottom">
                            <dxr:RibbonStatusBarControl.RightItems>
                                <!--<dxb:BarEditItem Name="edZoom"
                                                 EditWidth="150"
                                                 ShowScreenTip="False"
                                                 Content="{DXBinding '$string.Format(`{0:f0}%`, @p.ZoomValue)', Mode=OneWay}">    
                                    <dxb:BarEditItem.EditTemplate>
                                        <DataTemplate>
                                            <dxe:TrackBarEdit Width="150">
                                                <dxmvvm:Interaction.Behaviors>
                                                    <dxe:OfficeZoomTrackBarBehavior Value="{Binding RelativeSource={RelativeSource Self}, Path=(local:RichReportDesignerControl.Designer).ZoomValue, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="10" Maximum="500" />
                                                </dxmvvm:Interaction.Behaviors>
                                                <dxe:TrackBarEdit.StyleSettings>
                                                    <dxe:TrackBarZoomStyleSettings />
                                                </dxe:TrackBarEdit.StyleSettings>
                                            </dxe:TrackBarEdit>
                                        </DataTemplate>
                                    </dxb:BarEditItem.EditTemplate>
                                </dxb:BarEditItem>-->

                                <dxb:BarEditItem EditWidth="150" 
                                                 x:Name="zoomEdit" 
                                                 Content="{DXBinding '$string.Format(`{0:f0}%`, @s.EditValue)', Mode=OneWay}"
                                                 EditValue="1">
                                    <dxb:BarEditItem.EditSettings>
                                        <dxe:TrackBarEditSettings Minimum="0.3" Maximum="1.7" SmallStep="0.1" LargeStep="0.2">
                                            <dxe:TrackBarEditSettings.StyleSettings>
                                                <dxe:TrackBarZoomStyleSettings/>
                                            </dxe:TrackBarEditSettings.StyleSettings>
                                        </dxe:TrackBarEditSettings>
                                    </dxb:BarEditItem.EditSettings>
                                </dxb:BarEditItem>
                                
                            </dxr:RibbonStatusBarControl.RightItems>

                        </dxr:RibbonStatusBarControl>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>