<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:local="clr-namespace:ISoft.Wpf.RichReports.Controls" 
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    xmlns:isoftUtls="http://schemas.ISoft.com/winfx/2008/xaml/utils" 
                    xmlns:richcore="http://schemas.ISoft.com/winfx/2008/xaml/richReportDesigner/core" 
                    xmlns:Isoftui="http://schemas.ISoft.com/winfx/2008/xaml/core/ui">

    <Isoftui:DrawingColorToBrushConverter x:Key="colorConverter"/>
    <dxmvvm:BooleanToVisibilityConverter x:Key="boolToVisibilityConverter"/>
    
    <dxmvvm:ObjectToObjectConverter  x:Key="fieldCategoryToImageConverter" DefaultSource="{x:Static richcore:RichFieldDataTypeCategory.String}" DefaultTarget="{dx:DXImage SvgImages/Icon Builder/Actions_Question.svg}">
        <dxmvvm:MapItem Source="{x:Static richcore:RichFieldDataTypeCategory.String}"   Target="{dx:DXImage SvgImages/Spreadsheet/Text2.svg}"/>
        <dxmvvm:MapItem Source="{x:Static richcore:RichFieldDataTypeCategory.Numeric}"  Target="{dx:DXImage SvgImages/Spreadsheet/AccountingNumberFormat.svg}"/>
        <dxmvvm:MapItem Source="{x:Static richcore:RichFieldDataTypeCategory.DateTime}" Target="{dx:DXImage SvgImages/Spreadsheet/ShortDate.svg}"/>
        <dxmvvm:MapItem Source="{x:Static richcore:RichFieldDataTypeCategory.Boolean}"  Target="{dx:DXImage SvgImages/Spreadsheet/3SymbolsCircled.svg}"/>
        <dxmvvm:MapItem Source="{x:Static richcore:RichFieldDataTypeCategory.Image}"    Target="{dx:DXImage SvgImages/Dashboards/Images.svg}"/>
        <dxmvvm:MapItem Source="{x:Static richcore:RichFieldDataTypeCategory.Other}"    Target="{dx:DXImage SvgImages/Icon Builder/Actions_Question.svg}"/>
    </dxmvvm:ObjectToObjectConverter>

    <dxmvvm:ObjectToObjectConverter  x:Key="fieldGroupCategoryToImageConverter" DefaultSource="{x:Null}" DefaultTarget="{dx:DXImage SvgImages/Icon Builder/Actions_FolderClose.svg}">
        <dxmvvm:MapItem Source="{x:Static richcore:RichDisplayFieldGroupCategory.SystemFields}"   Target="{dx:DXImage SvgImages/Business Objects/BO_Address.svg}"/>
        <dxmvvm:MapItem Source="{x:Static richcore:RichDisplayFieldGroupCategory.DataFields}"  Target="{dx:DXImage SvgImages/Icon Builder/Actions_Database.svg}"/>
        <dxmvvm:MapItem Source="{x:Static richcore:RichDisplayFieldGroupCategory.DocumentProperties}"  Target="{dx:DXImage SvgImages/Outlook Inspired/CustomerProfileReport.svg}"/>
        <dxmvvm:MapItem Source="{x:Static richcore:RichDisplayFieldGroupCategory.CustomProperties}" Target="{dx:DXImage SvgImages/RichEdit/CustomizeMergeField.svg}"/>
        <dxmvvm:MapItem Source="{x:Static richcore:RichDisplayFieldGroupCategory.DocumentVariables}"  Target="{dx:DXImage SvgImages/Business Objects/BO_State.svg}"/>
        <dxmvvm:MapItem Source="{x:Static richcore:RichDisplayFieldGroupCategory.CalculatedFields}"  Target="{dx:DXImage SvgImages/Reports/AddCalculatedField.svg}"/>
    </dxmvvm:ObjectToObjectConverter>
    
    <Style x:Key="fieldItemContainerStyle" TargetType="dxa:AccordionItem">
        <Setter Property="Header" Value="{Binding DisplayName}"/>
        <Setter Property="Visibility" Value="{Binding IsVisible,Converter={StaticResource boolToVisibilityConverter}}" />
        <Setter Property="Glyph" Value="{Binding DataTypeCategory,Converter={StaticResource fieldCategoryToImageConverter}}" />
        <Setter Property="GlyphSize" Value="20,20"/>
        <Style.Triggers>
            <Trigger Property="ActualGlyphPosition" Value="Top">
                <Setter Property="ExpandButtonPosition" Value="None" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GroupItemContainerStyle" TargetType="dxa:AccordionItem">
        <Setter Property="Header" Value="{Binding DisplayName}"/>
        <Setter Property="Visibility" Value="{Binding IsVisible,Converter={StaticResource boolToVisibilityConverter}}" />
        <Setter Property="BorderBrush" Value="{Binding BackgroundColor,Converter={StaticResource colorConverter}}"/>
        <Setter Property="Glyph" Value="{Binding Category,Converter={StaticResource fieldGroupCategoryToImageConverter}}" />
        <Setter Property="GlyphSize" Value="20,20"/>
        <Setter Property="BorderThickness" Value="7,0,0,0" />
        <Setter Property="HighlightOnHover" Value="False"/>
        <Setter Property="HighlightOnPress" Value="False"/>
        <Setter Property="FontFamily" Value="Tajawal"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="ActualGlyphPosition" Value="Top">
                <Setter Property="ExpandButtonPosition" Value="None" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Trigger>
        </Style.Triggers>

    </Style>

    <DXStyleSelector x:Key="fieldItemStyleSelector">
        <DXStyleTrigger Binding="{Binding IsGroup}" Value="True" Style="{StaticResource GroupItemContainerStyle}"/>
        <DXStyleTrigger Binding="{Binding IsGroup}" Value="False" Style="{StaticResource fieldItemContainerStyle}"/>
    </DXStyleSelector>
        
    <!-- FieldsPanel Style -->
    <Style TargetType="{x:Type local:RichReportDesignerFieldsPanel}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RichReportDesignerFieldsPanel}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <DockPanel>
                            <dxa:AccordionControl
                                  x:Name="PART_Accordion"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  ExpandMode="SingleOrNone"
                                  SelectionUnit="SubItem"
                                  ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=FieldsSource}"
                                  ItemContainerStyleSelector="{StaticResource fieldItemStyleSelector}"
                                  ChildrenPath="Fields"
                                  ShowSearchControl="True"
                                  VerticalAlignment="Top"
                                  EmptySourceText="لا يوجد حقول"
                                  FontFamily="Tajawal"
                                  IsTabStop="False"
                                  Focusable="False"
                                  KeyboardNavigation.IsTabStop="False"
                                  KeyboardNavigation.ControlTabNavigation="None"
                                  KeyboardNavigation.DirectionalNavigation="None"
                                  KeyboardNavigation.TabNavigation="Cycle"
                                  ScrollViewer.CanContentScroll="False"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.PanningMode="None"/>   
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>