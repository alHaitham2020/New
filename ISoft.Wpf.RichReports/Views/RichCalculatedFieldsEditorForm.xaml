<Isoftui:DocumentViewControl x:Class="ISoft.RichReportDesigner.UI.View.RichCalculatedFieldsEditorForm"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                            xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                            xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                            xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:Isoftui="http://schemas.ISoft.com/winfx/2008/xaml/core/ui"
                            xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" 
                            xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                            mc:Ignorable="d"
                            FontWeight="SemiBold"
                            Width="700"
                            Height="400"
                            Isoftui:ViewAssist.WindowStyleType="Tool"
                            Isoftui:ViewAssist.WindowWidth="700" 
                            Isoftui:ViewAssist.WindowHeight="400"
                            Isoftui:ThemeAppearanceFontAssist.ApplyThemeFontToAll="True"
                            Isoftui:SplashScreenAssist.ShowSplashScreenOnLoading="True">    

    <DockPanel LastChildFill="True">

        <dxb:ToolBarControl Name="ActionToolbar"  BarItemDisplayMode="ContentAndGlyph" DockPanel.Dock="Top" Style="{Isoftui:BarsThemeResource ResourceId=CommonToolbarControlStyle}">
            <dxb:BarButtonItem Name="bAdd" 
                               Command="{Binding AddNewCommand}"
                               Style="{Isoftui:BarsThemeResource ResourceId=AddNewBarButtonStyle}"/>
            <dxb:BarButtonItem Name="bEdit" 
                               Command="{Binding EditCommand}"
                               CommandParameter="{Binding SelectedItem}"
                               Style="{Isoftui:BarsThemeResource ResourceId=EditBarButtonStyle}"/>
            <dxb:BarButtonItem Name="bDelete" 
                               Command="{Binding DeleteCommand}"
                               CommandParameter="{Binding SelectedItem}"
                               Style="{Isoftui:BarsThemeResource ResourceId=DeleteBarButtonStyle}"/>
            <dxb:BarItemSeparator />
            <dxb:BarButtonItem Name="bRefresh" 
                               Style="{Isoftui:BarsThemeResource ResourceId=RefreshBarButtonStyle}"
                               Command="{Binding RefreshCommand}"/>
        </dxb:ToolBarControl>

        <dxg:GridControl
                ItemsSource="{Binding FieldsSource}"
                SelectedItem="{Binding SelectedItem,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                Style="{Isoftui:GridControlThemeResource ResourceId=CommonGridControlStyle}">
            <dxg:GridColumn Width="1*" Header="الوصف" FieldName="DisplayName"/>
            <dxg:GridColumn DefaultSortOrder="Descending" Width="1*" Header="الإسم" FieldName="FieldName" />
            <dxg:GridColumn Width="0.5*" Header="النوع" FieldName="FieldType"/>
            <dxg:GridColumn Width="0.6*" Header="ضمن جدول" FieldName="IsDetail" Style="{Isoftui:GridControlThemeResource ResourceId=BooleanColumnStyle}" />
            <dxg:GridColumn Width="2*" Header="المعادلة" FieldName="Expression"/>
            <dxg:GridControl.View>
                <dxg:TableView  AutoWidth="False"
                                AllowEditing="False"
                                NewItemRowPosition="None"
                                AllowFilterEditor="False"
                                AllowMoveColumnToDropArea="False"
                                AllowScrollToFocusedRow="True"
                                FontWeight="SemiBold"
                                ColumnFilterPopupMode="Disabled"
                                AllowColumnFiltering="False"
                                Style="{Isoftui:GridControlThemeResource ResourceId=CommonTableViewStyle}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand EventName="RowDoubleClick" Command="{Binding EditCommand}" CommandParameter="{Binding SelectedItem}" />
                        <dxmvvm:KeyToCommand   KeyGesture="F9" Command="{DXBinding EditCommand}" CommandParameter="{Binding SelectedItem}"/>
                    </dxmvvm:Interaction.Behaviors>
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>

    </DockPanel>

</Isoftui:DocumentViewControl>