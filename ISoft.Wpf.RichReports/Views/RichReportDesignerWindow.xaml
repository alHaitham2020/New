<dx:ThemedWindow
    x:Class="ISoft.Wpf.RichReports.View.RichReportDesignerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:Isoftui="http://schemas.ISoft.com/winfx/2008/xaml/core/ui"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
     xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
     xmlns:local="clr-namespace:ISoft.Wpf.RichReports.Controls"
     xmlns:localserv="clr-namespace:ISoft.Wpf.RichReports.Services.UI"
     xmlns:vm="clr-namespace:ISoft.Wpf.RichReports.ViewModels" 
     xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" 
     xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" 
     xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
     xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
     xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
     xmlns:localt="clr-namespace:ISoft.Wpf.RichReports.Markup.ThemeResources"
     xmlns:dxre="http://schemas.devexpress.com/winfx/2008/xaml/richedit"
    Title="DXWindow1" Height="800" Width="1000" WindowState="Maximized" WindowStartupLocation="CenterOwner">

    <DockPanel>

        <local:RichReportDesignerControl x:Name="designer">

            <dxmvvm:Interaction.Behaviors>
                <localserv:RichReportDesignerControlService/>
                <!--<dxmvvm:EventToCommand EventName="TemplateSaved" Command="{Binding TemplateSavedCommand}" PassEventArgsToCommand="True"/>-->
            </dxmvvm:Interaction.Behaviors>

        </local:RichReportDesignerControl>

    </DockPanel>

</dx:ThemedWindow>
