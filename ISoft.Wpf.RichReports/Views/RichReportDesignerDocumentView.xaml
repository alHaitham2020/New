<Isoftui:DocumentViewControl  
             x:Class="ISoft.RichReportDesigner.UI.View.RichReportDesignerDocumentView"
             xmlns:Isoftui="http://schemas.ISoft.com/winfx/2008/xaml/core/ui"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
             xmlns:local="clr-namespace:ISoft.RichReportDesigner.UI.Controls"
             xmlns:localserv="clr-namespace:ISoft.RichReportDesigner.UI.UIServices"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800"
             Isoftui:ViewAssist.WindowState="Maximized"
             Isoftui:ViewAssist.WindowBorderStyle="SingleBorderWindow"
             Isoftui:ViewAssist.WindowResizeMode="CanResize"
             Isoftui:ViewAssist.WindowStyleType="Custom"
             Isoftui:ViewAssist.WindowWidth="900"
             Isoftui:ViewAssist.WindowHeight="550">

    <DockPanel>

        <local:RichReportDesignerControl Report="{Binding Report}">
            <dxmvvm:Interaction.Behaviors>
                <localserv:RichReportDesignerControlService/>
            </dxmvvm:Interaction.Behaviors>
        </local:RichReportDesignerControl>
        
    </DockPanel>
    
</Isoftui:DocumentViewControl>
